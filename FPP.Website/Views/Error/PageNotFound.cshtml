@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found</title>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <environment include="Development">
	    <link rel="stylesheet" href="~/css/dev/pages/error.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
	    <link rel="stylesheet" href="~/css/pro/pages/error.chunk.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <div class="page-error page-error-404">
        <div class="page-content vertical-align-middle">
            <header>
                <div class="img-block">
                    <img class="img-main" src="~/images/404/404.svg" alt="404.svg" />
                    <img class="balloon" src="~/images/404/balloon.svg" alt="balloon.svg" />
                    <img class="small-cloud" src="~/images/404/cloud-small.svg" alt="cloud-small.svg" />
                    <img class="big-cloud" src="~/images/404/cloud-big.svg" alt="cloud-big.svg" />
                    <img class="wind-bottom" src="~/images/404/wind.svg" alt="wind.svg" />
                    <img class="wind-top" src="~/images/404/wind.svg" alt="wind.svg" />
                </div>
            </header>
            <p class="error-advise">Oops. The page you are looking for doesn't exist.</p>
            <a class="cta" href="@Url.Action("index", "home")">
                <span class="icon-back"></span> Take me back to the dashboard
            </a>
        </div>
    </div>
</body>
</html>
