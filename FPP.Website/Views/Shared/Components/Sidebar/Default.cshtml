@using GO.UserControl.Client.Core.Models
@using System.Globalization
@using System.Linq
@model IList<MenuItem>

@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var area = ViewContext.RouteData.DataTokens["Area"]?.ToString();
    var url = $"{(!string.IsNullOrWhiteSpace(area) ? $"/{area}" : string.Empty)}/{controller}";

    var iconMap = new Dictionary<string, string>
    {
        { "report", "bi-bar-chart-fill" },
        { "upload", "bi-upload" },
        { "invoice", "bi-file-earmark-text" },
        { "default", "bi-upload" },
    };
}

<div id="layoutSidenav_nav">
    <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
        <div class="sb-sidenav-menu">
            <div class="nav">
                @foreach (var item in Model)
                {
                    var classActive = url == item.URL ? "active" : "";
                    var iconClass = iconMap.FirstOrDefault(icon => 
                        item.URL.ToLower(CultureInfo.InvariantCulture).Contains(icon.Key)).Value ?? "bi-upload";
                    <a class="nav-link @classActive" href="@item.URL">
                        <i class="bi @iconClass me-2"></i> @item.MenuItemName
                    </a>
                }
            </div>
        </div>
    </nav>
</div>