@{
    ViewData["Title"] = "BU P&L Consolidation Report";
}
@section Styles{
     <environment include="Development">
        <link rel="stylesheet" media="all" href="~/css/dev/pages/costExpense/report/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" media="all" href="~/css/pro/pages/costExpense/report/index.chunk.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <environment include="Development">
