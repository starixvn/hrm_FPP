@{
    ViewData["Title"] = "Inter Invoice Create";
}
@section Styles{
     <environment include="Development">
        <link rel="stylesheet" media="all" href="~/css/dev/pages/interInvoice/create/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" media="all" href="~/css/pro/pages/interInvoice/create/index.chunk.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
	<script>
        window.invoiceId = @Model;
    </script>
    <environment include="Development">
        <script src="~/js/dev/pages/interInvoice/edit/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/interInvoice/edit/index.chunk.js" asp-append-version="true"></script>
    </environment>

}
<div class="container-fluid">
   <div id="app-container"></div>
</div>
